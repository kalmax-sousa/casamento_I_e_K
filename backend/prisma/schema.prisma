generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ÁREA ADMINISTRATIVA
// ==========================================
model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash da senha (ex: bcrypt)
  createdAt DateTime @default(now())
}

// ==========================================
// CONFIRMAÇÃO DE PRESENÇA (RSVP)
// ==========================================
model Family {
  id        String   @id @default(uuid())
  name      String   @unique
  guests    Guest[]
  createdAt DateTime @default(now())
}

model Guest {
  id          String  @id @default(uuid())
  name        String
  isConfirmed Boolean @default(false)

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// LISTA DE PRESENTES (Estilo E-commerce)
// ==========================================
// ==========================================
// LISTA DE PRESENTES (Estilo E-commerce)
// ==========================================
model Gift {
  id          String  @id @default(uuid())
  name        String
  description String?
  photoUrl    String
  price       Float

  specifications String?
  storeLinks     String[]

  totalQuantity     Int @default(1)
  purchasedQuantity Int @default(0)

  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Purchase {
  id String @id @default(uuid())

  giftId String
  gift   Gift   @relation(fields: [giftId], references: [id])

  buyerName String
  guestId   String?
  guest     Guest?  @relation(fields: [guestId], references: [id])

  message       String?
  paymentMethod String  @default("STRIPE")

  quantityBought Int   @default(1)
  amountPaid     Float

  status        String  @default("PENDING")
  stripeSession String?

  createdAt DateTime @default(now())
}

// ==========================================
// DESAFIO DE FOTOS
// ==========================================
model Photo {
  id         String   @id @default(uuid())
  url        String // URL do S3, Cloudinary, etc.
  guestName  String? // Opcional: quem fez o upload
  isApproved Boolean  @default(true) // Caso queira moderar as fotos depois
  createdAt  DateTime @default(now())
}
